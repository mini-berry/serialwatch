{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "serialwatch",
  "version": "1.1.2",
  "identifier": "com.berry.serialwatch",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "串口调试助手 S.W.R.",
        "width": 600,
        "height": 550,
        "minWidth": 400,
        "minHeight": 250
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}